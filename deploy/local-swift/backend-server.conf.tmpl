[DEFAULT]
bind_ip = 127.0.0.1
bind_port = $port
user = swift
workers = 1
devices = /srv/swift-poc
mount_check = true
swift_dir = /etc/swift
log_name = swift-poc-$server
log_level = INFO

[pipeline:main]
pipeline = healthcheck $server-server

[filter:healthcheck]
use = egg:swift#healthcheck

[app:$server-server]
use = egg:swift#$server

[$server-updater]
interval = 30
concurrency = 1

[$server-auditor]
interval = 300
